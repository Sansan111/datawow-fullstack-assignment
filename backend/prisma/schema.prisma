generator client {
provider = "prisma-client-js"
output = "../generated/prisma"
}

datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

enum Role {
USER
ADMIN
}

enum ReservationStatus {
RESERVED
CANCELLED
}

enum AuditAction {
RESERVE
CANCEL
EVENT_DELETED
}

model User {
id Int @id @default(autoincrement())
name String @default("")
email String @unique
password String
role Role @default(USER)
reservations Reservation[]
auditLogs AuditLog[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model Concert {
id Int @id @default(autoincrement())
name String
description String
totalSeats Int
deletedAt DateTime?
reservations Reservation[]
auditLogs AuditLog[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model AuditLog {
id Int @id @default(autoincrement())
userId Int
concertId Int
action AuditAction
user User @relation(fields: [userId], references: [id])
concert Concert @relation(fields: [concertId], references: [id])
createdAt DateTime @default(now())
}

model Reservation {
id Int @id @default(autoincrement())
userId Int
concertId Int
status ReservationStatus @default(RESERVED)
user User @relation(fields: [userId], references: [id])
concert Concert @relation(fields: [concertId], references: [id])
createdAt DateTime @default(now())

@@unique([userId, concertId])
}
